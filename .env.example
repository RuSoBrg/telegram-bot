# Serviços autorizados no teu cenário: Azure OpenAI/Gemini e o servidor Azure.
# Não configurar chaves de outros fornecedores sem validar previamente o custo.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4
# Opcional; usar apenas os créditos gratuitos disponíveis na tua conta.
TAVILY_API_KEY=
SUPERVISOR_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
VERTEX_MUSIC_MODEL=lyria-002
MAX_QUALITY_ITERATIONS=3
REQUIRE_HUMAN_APPROVAL=true
MAX_RESEARCH_RESULTS=5
MAX_GENERATED_CONTENT_CHARS=100000
MAX_MEDIA_SECONDS=60
TOOL_TIMEOUT_SECONDS=600
MAX_ARTIFACT_BYTES=52428800
MAX_USER_OPERATIONS=100
QUOTA_WINDOW_SECONDS=86400
OBJECT_STORAGE_BACKEND=memory
OBJECT_STORAGE_URL=memory://artifacts
GCS_BUCKET=
GCS_PREFIX=ai-workspace
WORKFLOW_DB_PATH=workspace.db
ARTIFACT_DB_PATH=workspace.db
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=https://bot.example.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TUNNEL_TOKEN=
PORT=8000
# Para produção: postgresql://utilizador:password@host:5432/ai_workspace
# WORKFLOW_DB_PATH=postgresql://...
CHECKPOINT_DB_PATH=workspace-checkpoints.db
RESEARCH_CACHE_PATH=research-cache.db
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_CACHE_ENABLED=true

# Perfil recomendado sem custos adicionais:
# Azure OpenAI/Gemini usam apenas os créditos/subscrição já existentes.
# Redis, PostgreSQL e GCS devem permanecer sem configuração. Tavily é permitido
# apenas dentro dos créditos gratuitos disponíveis na tua conta.
# SQLite, cache local, object storage local e execução síncrona são gratuitos.
#
# Diretórios que o agente de engenharia pode ler, separados por ";" no Windows.
# Se ficar vazio, apenas o workspace atual é permitido.
AGENT_ALLOWED_ROOTS=
