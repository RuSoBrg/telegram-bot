# Telegram
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# PostgreSQL (the hostname is the Compose service name)
POSTGRES_DB=ai_workspace
POSTGRES_USER=ai_workspace
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ai_workspace:replace-with-a-long-random-password@db:5432/ai_workspace

# LiteLLM provider credentials
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
COHERE_API_KEY=
LITELLM_MASTER_KEY=

# Runtime and safety limits
REQUIRE_HUMAN_APPROVAL=true
MAX_QUALITY_ITERATIONS=3
MAX_STEPS=5
MAX_RESEARCH_RESULTS=5
MAX_GENERATED_CONTENT_CHARS=100000
MAX_MEDIA_SECONDS=60
TOOL_TIMEOUT_SECONDS=600
MAX_ARTIFACT_BYTES=52428800
MAX_USER_OPERATIONS=100
QUOTA_WINDOW_SECONDS=86400
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_CACHE_ENABLED=true

# Local object storage inside the container
OBJECT_STORAGE_PATH=/app/data
AGENT_ALLOWED_ROOTS=
